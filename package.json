{
  "name": "@local/dsh-preset-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compact single-page Tools, Prompts and Skills policy editor for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "src/policy.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-remotes"]}
  },
  "peerDependencies": {"@deepseek-ai/schemastery": "*"},
  "scripts": {"test": "node --test tests/*.test.js", "check": "node --check index.js && node --check client.js && node --check src/policy.js && npm test"}
}
